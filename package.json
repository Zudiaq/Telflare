{
  "name": "webui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node -e \"const fs=require('fs'); fs.cpSync('dist/assets', 'assets', {recursive:true}); fs.copyFileSync('dist/sw.js', 'sw.js');\"",
    "deploy": "npm run build && npx wrangler deploy",
    "lint": "oxlint",
    "preview": "vite preview"
  },
