{
  "name": "zud-cloud",
  "main": "./cf-worker/worker.js",
  "compatibility_date": "2025-09-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/ws",
      "/ws/*",
      "/apiws",
      "/apiws/*",
      "/tgws",
      "/tgws/*",
      "/health",
      "/cover",
      "/api/*"
    ]
  }
}
